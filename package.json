{
  "name": "vinny-footermanager",
  "version": "1.0.0",
  "description": "Footer Manager for phpBB - CSS and JS Linting",
  "scripts": {
    "test": "npm run lint:js && npm run lint:css",
    "lint:js": "npx --no-install eslint \"adm/style/js/**/*.js\" \"styles/**/*.js\" --ignore-pattern \"**/*.min.js\" --no-error-on-unmatched-pattern",
    "lint:css": "npx --no-install stylelint \"adm/style/css/**/*.css\" \"styles/**/*.css\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0"
  }
}
